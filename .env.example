# Copy this file to .env and fill in your values. Never share .env.

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Telegram: create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=123456789
